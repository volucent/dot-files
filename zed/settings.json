// Zed settings for agent orchestration: agents drive, I review.
// Tuned for light-sensitive eyes: warm brown-gray theme, no pure white or
// black, low-vision fonts, no blinking.
//
// Keys verified against Zed 1.26.2's assets/settings/default.json.
{
  "$schema": "zed://schemas/settings",

  // ---------------------------------------------------------------------------
  // Look and feel
  // ---------------------------------------------------------------------------
  // Umber lives in ./themes/umber.json (generated by ./gen-theme.py).
  // "Umber Light" is a parchment variant; switch with `theme selector: toggle`.
  "theme": {
    "mode": "dark",
    "dark": "Umber",
    "light": "Umber Light",
  },
  "icon_theme": "Zed (Default)",

  // Intel One Mono: designed with and for low-vision developers.
  "buffer_font_family": "Intel One Mono",
  "buffer_font_weight": 500,
  "buffer_font_size": 15,
  "buffer_line_height": { "custom": 1.5 },

  // Atkinson Hyperlegible Next: Braille Institute's low-vision typeface.
  // Agent output is most of what I read, so it gets the largest size.
  "ui_font_family": "Atkinson Hyperlegible Next",
  "ui_font_weight": 400,
  "ui_font_size": 16,
  "agent_ui_font_family": "Atkinson Hyperlegible Next",
  "agent_ui_font_size": 17,
  "agent_buffer_font_family": "Intel One Mono",
  "agent_buffer_font_size": 15,
  "git_commit_buffer_font_size": 14,
  "markdown_preview": {
    "font_size": 16,
  },

  "cursor_blink": false,
  "cursor_shape": "bar",
  "current_line_highlight": "all",
  "unnecessary_code_fade": 0.3,
  "minimap": { "show": "never" },
  "scrollbar": { "show": "auto" },

  // Coming from WebStorm.
  "base_keymap": "JetBrains",
  "which_key": { "enabled": true, "delay_ms": 600 },

  // ---------------------------------------------------------------------------
  // Agentic layout: agent panel + threads sidebar on the left, project/git on
  // the right (same as `workspace: use agentic layout`).
  // ---------------------------------------------------------------------------
  "agent": {
    "dock": "left",
    "flexible": true,
    "threads_sidebar": {
      "position": "left",
      "auto_open": true,
    },
    "limit_content_width": true,
    "max_content_width": 900,
    "notify_when_agent_waiting": "primary_screen",
    "play_sound_when_agent_done": "when_hidden",
    "prevent_idle_sleep": true,
    "show_turn_stats": true,
    "expand_edit_card": true,
    "expand_terminal_card": false,
    "message_editor_min_lines": 4,
    // Terminal Threads open straight into Claude Code's TUI.
    "terminal_init_command": "claude",
    // Native Zed Agent guardrails (Claude/Codex keep their own permission modes,
    // but "confirm"/"deny" here still win over them).
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "terminal": {
          "default": "confirm",
          "always_confirm": [
            { "pattern": "git\\s+(reset|clean)\\s+--hard" },
            { "pattern": "git\\s+push\\s+(-f|--force)" },
            { "pattern": "rm\\s+-rf?\\s" },
          ],
        },
        "edit_file": {
          "always_deny": [
            { "pattern": "\\.env($|\\.)" },
            { "pattern": "\\.pem$" },
            { "pattern": "\\.key$" },
          ],
        },
        "write_file": {
          "always_deny": [
            { "pattern": "\\.env($|\\.)" },
            { "pattern": "\\.pem$" },
            { "pattern": "\\.key$" },
          ],
        },
      },
    },
  },

  // External agents from the ACP registry (they bring their own auth/config,
  // e.g. Claude reads ~/.claude/settings.json and CLAUDE.md).
  "agent_servers": {
    "claude-acp": { "type": "registry" },
    "codex-acp": { "type": "registry" },
  },

  "project_panel": {
    "dock": "right",
    "auto_reveal_entries": true,
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "Intel One Mono",
    "font_size": 14,
    "line_height": "standard",
    "cursor_shape": "bar",
    "blinking": "off",
    "option_as_meta": true,
  },

  // ---------------------------------------------------------------------------
  // Git: inline blame on the current line, history one keystroke away
  // ---------------------------------------------------------------------------
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 150,
      "location": "inline",
      "padding": 7,
      "show_commit_summary": true,
      "min_column": 0,
    },
    "blame": {
      "show_avatar": true,
    },
    "hunk_style": "staged_hollow",
  },
  "tabs": {
    "git_status": true,
    "file_icons": true,
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_onboarding_banner": false,
  },

  // ---------------------------------------------------------------------------
  // Less editing chrome: I mostly read and review what agents wrote
  // ---------------------------------------------------------------------------
  "show_edit_predictions": false,
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "agent_review": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "gutter": {
    "runnables": false,
    "breakpoints": false,
    "min_line_number_digits": 3,
  },
  "collaboration_panel": { "button": false },
  "debugger": { "button": false },

  // Agents write files underneath me; save as soon as I look away so we never
  // fight over a dirty buffer.
  "autosave": "on_focus_change",
  "restore_on_startup": "last_session",
}
