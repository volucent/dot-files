// Layered on top of the JetBrains base keymap (see settings.json).
// JetBrains tool-window slots: cmd-1 project, cmd-2 and cmd-0 git panel,
// cmd-3 and cmd-9 git history (Git Graph). The agent panel has no slot.
[
  {
    // Zed's default cmd-0 (no context) resets the code font zoom, and it can
    // fire instead of the git panel toggle. Drop it; `zed: reset all zoom`
    // still does that from the command palette.
    "bindings": {
      "cmd-0": null,
    },
  },
  {
    // cmd-0 / cmd-2 close the git panel from anywhere inside it, the commit
    // message editor included (JetBrains only binds cmd-0 at the panel
    // itself, and Zed's cmd-2 there switches to the History tab).
    "context": "GitPanel || GitPanel > Editor",
    "bindings": {
      "cmd-0": "workspace::CloseActiveDock",
      "cmd-2": "workspace::CloseActiveDock",
      "cmd-3": "git_graph::Open",
    },
  },
  {
    // JetBrains unbinds cmd-2 / cmd-3 in editor tabs (Pane); bind them there.
    "context": "Pane",
    "bindings": {
      "cmd-2": "git_panel::ToggleFocus",
      "cmd-3": "git_graph::Open",
    },
  },
  {
    // cmd-3 toggles Git Graph: it opens it everywhere else and closes it here.
    "context": "GitGraph",
    "bindings": {
      "cmd-3": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-2": "git_panel::ToggleFocus",
      "cmd-3": "git_graph::Open",
      "cmd-9": "git_graph::Open",
      "ctrl-`": "terminal_panel::Toggle",

      // Zoom code and UI together (JetBrains puts fold/unfold here). In the
      // agent panel these resize the agent fonts instead. cmd-0 stays the git
      // panel; `zed: reset all zoom` undoes it.
      "cmd-=": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd-+": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd--": ["action::Sequence", [["zed::DecreaseBufferFontSize", { "persist": false }], ["zed::DecreaseUiFontSize", { "persist": false }]]],

      // New threads per agent.
      "cmd-alt-1": ["agent::NewExternalAgentThread", { "agent": "claude-acp" }],
      "cmd-alt-2": ["agent::NewExternalAgentThread", { "agent": "codex-acp" }],
      "cmd-alt-3": "agent::NewTerminalThread",

      // Git history (cmd-alt-g b toggles full-file blame by default).
      "cmd-alt-g h": "git::FileHistory",
      "cmd-alt-g g": "git_graph::Open",
    },
  },
  {
    // While the git panel is showing in the left dock, cmd-2 closes it from
    // anywhere, not only from inside it. Without this, cmd-2 from an editor
    // or a commit opened from the History tab just moves focus back into the
    // panel. These come after the plain Workspace / Pane bindings so they win.
    "context": "Workspace && left_dock == GitPanel",
    "bindings": {
      "cmd-2": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Workspace && left_dock == GitPanel > Pane",
    "bindings": {
      "cmd-2": "workspace::ToggleLeftDock",
    },
  },
  {
    // JetBrains unmaps zoom and reuses shift-escape to hide the active dock.
    "context": "Dock || Workspace || OutlinePanel || ProjectPanel || CollabPanel",
    "bindings": {
      "shift-escape": "workspace::ToggleZoom",
    },
  },
  {
    // JetBrains scopes cmd-shift-f to the selected folder here; search the
    // whole project like everywhere else.
    "context": "ProjectPanel",
    "bindings": {
      "cmd-shift-f": "pane::DeploySearch",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-alt-g h": "git::FileHistory",

      // u = usages, r = rename (instead of alt-f7 / shift-f6).
      "cmd-alt-u": "editor::FindAllReferences",
      "ctrl-cmd-r": "editor::Rename",
      "cmd-.": "editor::ToggleCodeActions",

      // Zed/VS Code line moves (JetBrains had these on extend selection;
      // extend/shrink stays on ctrl-cmd-right/left).
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown",

      // Split instead of JetBrains' inline assist.
      "cmd-\\": "pane::SplitRight",

      // JetBrains binds fold/unfold here at Editor depth, which outranks the
      // Workspace zoom bindings above, so repeat them.
      "cmd-=": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd--": ["action::Sequence", [["zed::DecreaseBufferFontSize", { "persist": false }], ["zed::DecreaseUiFontSize", { "persist": false }]]],

      // WebStorm's collapse/expand all: cmd-shift-minus / cmd-shift-equals
      // (Zed spells shifted keys by the character they type).
      "cmd-_": "editor::FoldAll",
      "cmd-+": "editor::UnfoldAll",
    },
  },
  {
    // Inline assist stays unbound; use the command palette.
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "ctrl-enter": null,
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-enter": null,
    },
  },
  {
    // Accept / reject all agent edits. Not bound inside the message editor,
    // where cmd-shift-enter sends immediately and cmd-shift-backspace drops
    // the first queued message.
    "context": "AgentDiff || (Editor && editor_agent_diff) || AcpThread",
    "bindings": {
      "cmd-shift-enter": "agent::KeepAll",
      "cmd-shift-backspace": "agent::RejectAll",
    },
  },
]
