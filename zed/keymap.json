// Layered on top of the JetBrains base keymap (see settings.json).
//
// cmd-N switches tabs, as in browsers and Ghostty: cmd-1..8 go to tab N in the
// current split, cmd-9 to the last tab, cmd-0 resets zoom.
// option-N opens and closes tool windows from anywhere (JetBrains' Windows and
// Linux slots): 1 terminal, 2 project, 3 outline, 4 git panel, 5 Git Graph,
// 6 diagnostics, 7 debug, 0 hides or restores every dock. The agent panel
// has no slot. On the Voyager, hold Option on the other hand from the digit.
[
  {
    // Replaces Zed's code-only zoom reset (no context).
    "bindings": {
      "cmd-0": "zed::ResetAllZoom",
    },
  },
  {
    // JetBrains puts tool windows on cmd-N (and clears the rest in Pane);
    // take the digits back for tabs, in editors and everywhere else.
    "context": "Workspace || Pane",
    "bindings": {
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-5": ["pane::ActivateItem", 4],
      "cmd-6": ["pane::ActivateItem", 5],
      "cmd-7": ["pane::ActivateItem", 6],
      "cmd-8": ["pane::ActivateItem", 7],
      "cmd-9": "pane::ActivateLastItem",
      "cmd-0": "zed::ResetAllZoom",
    },
  },
  {
    // JetBrains closes these on cmd-N from inside; inside a panel cmd-N now
    // does nothing (the git panel keeps Zed's cmd-1 Changes / cmd-2 History).
    "context": "ProjectPanel || DebugPanel || OutlinePanel",
    "bindings": {
      "cmd-1": null,
      "cmd-5": null,
      "cmd-7": null,
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "cmd-0": "zed::ResetAllZoom",
    },
  },
  {
    "context": "Diagnostics > Editor",
    "bindings": {
      "cmd-6": ["pane::ActivateItem", 5],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // Tool windows. The dock rules below make these close the panel when
      // it is already showing, wherever focus is.
      "alt-1": "terminal_panel::ToggleFocus",
      "alt-2": "project_panel::ToggleFocus",
      "alt-3": "outline_panel::ToggleFocus",
      "alt-4": "git_panel::ToggleFocus",
      "alt-5": "git_graph::Open",
      "alt-6": "diagnostics::Deploy",
      "alt-7": "debug_panel::ToggleFocus",
      "alt-0": "workspace::ToggleAllDocks",
      "ctrl-`": "terminal_panel::Toggle",

      // Zoom code and UI together (JetBrains puts fold/unfold here). In the
      // agent panel these resize the agent fonts instead; cmd-0 resets.
      "cmd-=": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd-+": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd--": ["action::Sequence", [["zed::DecreaseBufferFontSize", { "persist": false }], ["zed::DecreaseUiFontSize", { "persist": false }]]],

      // New threads per agent.
      "cmd-alt-1": ["agent::NewExternalAgentThread", { "agent": "claude-acp" }],
      "cmd-alt-2": ["agent::NewExternalAgentThread", { "agent": "codex-acp" }],
      "cmd-alt-3": "agent::NewTerminalThread",

      // Git history (cmd-alt-g b toggles full-file blame by default).
      "cmd-alt-g h": "git::FileHistory",
      "cmd-alt-g g": "git_graph::Open",
    },
  },
  // While a panel is showing in a dock, its option-N hides that dock from
  // anywhere. Plain ToggleFocus would only move focus back into an open but
  // unfocused panel. Every dock side is listed so moving a panel keeps
  // working; these come after the Workspace block so they win.
  {
    "context": "Workspace && left_dock == ProjectPanel",
    "bindings": { "alt-2": "workspace::ToggleLeftDock" },
  },
  {
    "context": "Workspace && left_dock == GitPanel",
    "bindings": { "alt-4": "workspace::ToggleLeftDock" },
  },
  {
    "context": "Workspace && left_dock == TerminalPanel",
    "bindings": { "alt-1": "workspace::ToggleLeftDock" },
  },
  {
    "context": "Workspace && left_dock == DebugPanel",
    "bindings": { "alt-7": "workspace::ToggleLeftDock" },
  },
  {
    "context": "Workspace && left_dock == OutlinePanel",
    "bindings": { "alt-3": "workspace::ToggleLeftDock" },
  },
  {
    "context": "Workspace && right_dock == ProjectPanel",
    "bindings": { "alt-2": "workspace::ToggleRightDock" },
  },
  {
    "context": "Workspace && right_dock == GitPanel",
    "bindings": { "alt-4": "workspace::ToggleRightDock" },
  },
  {
    "context": "Workspace && right_dock == TerminalPanel",
    "bindings": { "alt-1": "workspace::ToggleRightDock" },
  },
  {
    "context": "Workspace && right_dock == DebugPanel",
    "bindings": { "alt-7": "workspace::ToggleRightDock" },
  },
  {
    "context": "Workspace && right_dock == OutlinePanel",
    "bindings": { "alt-3": "workspace::ToggleRightDock" },
  },
  {
    "context": "Workspace && bottom_dock == ProjectPanel",
    "bindings": { "alt-2": "workspace::ToggleBottomDock" },
  },
  {
    "context": "Workspace && bottom_dock == GitPanel",
    "bindings": { "alt-4": "workspace::ToggleBottomDock" },
  },
  {
    "context": "Workspace && bottom_dock == TerminalPanel",
    "bindings": { "alt-1": "workspace::ToggleBottomDock" },
  },
  {
    "context": "Workspace && bottom_dock == DebugPanel",
    "bindings": { "alt-7": "workspace::ToggleBottomDock" },
  },
  {
    "context": "Workspace && bottom_dock == OutlinePanel",
    "bindings": { "alt-3": "workspace::ToggleBottomDock" },
  },
  {
    // Git Graph and diagnostics are tabs, not panels: close them from inside.
    "context": "GitGraph",
    "bindings": {
      "alt-5": "pane::CloseActiveItem",
    },
  },
  {
    "context": "Diagnostics > Editor",
    "bindings": {
      "alt-6": "pane::CloseActiveItem",
    },
  },
  {
    // JetBrains unmaps zoom and reuses shift-escape to hide the active dock.
    "context": "Dock || Workspace || OutlinePanel || ProjectPanel || CollabPanel",
    "bindings": {
      "shift-escape": "workspace::ToggleZoom",
    },
  },
  {
    // JetBrains scopes cmd-shift-f to the selected folder here; search the
    // whole project like everywhere else.
    "context": "ProjectPanel",
    "bindings": {
      "cmd-shift-f": "pane::DeploySearch",
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-alt-g h": "git::FileHistory",

      // u = usages, r = rename (instead of alt-f7 / shift-f6).
      "cmd-alt-u": "editor::FindAllReferences",
      "ctrl-cmd-r": "editor::Rename",
      "cmd-.": "editor::ToggleCodeActions",

      // Zed/VS Code line moves (JetBrains had these on extend selection;
      // extend/shrink stays on ctrl-cmd-right/left).
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown",

      // Split instead of JetBrains' inline assist.
      "cmd-\\": "pane::SplitRight",

      // JetBrains binds fold/unfold here at Editor depth, which outranks the
      // Workspace zoom bindings above, so repeat them.
      "cmd-=": ["action::Sequence", [["zed::IncreaseBufferFontSize", { "persist": false }], ["zed::IncreaseUiFontSize", { "persist": false }]]],
      "cmd--": ["action::Sequence", [["zed::DecreaseBufferFontSize", { "persist": false }], ["zed::DecreaseUiFontSize", { "persist": false }]]],

      // WebStorm's collapse/expand all: cmd-shift-minus / cmd-shift-equals
      // (Zed spells shifted keys by the character they type).
      "cmd-_": "editor::FoldAll",
      "cmd-+": "editor::UnfoldAll",
    },
  },
  {
    // Inline assist stays unbound; use the command palette.
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "ctrl-enter": null,
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-enter": null,
    },
  },
  {
    // Accept / reject all agent edits. Not bound inside the message editor,
    // where cmd-shift-enter sends immediately and cmd-shift-backspace drops
    // the first queued message.
    "context": "AgentDiff || (Editor && editor_agent_diff) || AcpThread",
    "bindings": {
      "cmd-shift-enter": "agent::KeepAll",
      "cmd-shift-backspace": "agent::RejectAll",
    },
  },
]
