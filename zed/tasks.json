// Global Zed tasks.
[
  {
    // Parallel agents get fresh git worktrees without untracked files.
    // Copy .env from the main checkout if it has one; never overwrite.
    "label": "Copy .env into new worktree",
    "command": "[ -f \"$ZED_MAIN_GIT_WORKTREE/.env\" ] && cp -n \"$ZED_MAIN_GIT_WORKTREE/.env\" \"$ZED_WORKTREE_ROOT/.env\" || true",
    "hooks": ["create_worktree"],
    "reveal": "no_focus",
    "hide": "on_success",
  },
]
