{
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git add:*)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git commit:*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status *)",
      "Bash(glab mr diff:*)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(printf *)",
      "Bash(printenv *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(type *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/notify-input.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "outputStyle": "Proactive",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "high"
    }
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true,
  "skillOverrides": {
    "caveman": "off",
    "codebase-design": "off",
    "diagnosing-bugs": "off",
    "domain-modeling": "off",
    "prototype": "off",
    "research": "off",
    "tdd": "off",
    "weekly-report": "off",
    "write-a-skill": "off",
    "ask-matt": "off",
    "implement": "off",
    "improve-codebase-architecture": "off",
    "setup-matt-pocock-skills": "off",
    "to-spec": "off",
    "to-tickets": "off",
    "triage": "off",
    "wayfinder": "off",
    "grill-with-docs": "off"
  },
  "enabledPlugins": {
    "mattpocock-skills@synced": false,
    "cowork-plugin-management@synced": false,
    "anthropic-skills@inline": false
  }
}
